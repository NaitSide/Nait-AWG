[Unit]
Description=Nait-AWG panel (existing AmneziaWG)
After=network-online.target docker.service nait-awg-receiver-selfhost.service nait-awg-domain.service
Wants=network-online.target nait-awg-domain.service
Requires=docker.service nait-awg-receiver-selfhost.service

[Service]
Type=simple
User=nait-awg
Group=nait-awg
SupplementaryGroups=docker
WorkingDirectory=/opt/naitlab/nait_awg
EnvironmentFile=/opt/naitlab/nait_awg/.env
ExecStart=/opt/naitlab/nait_awg/runtime/bin/node /opt/naitlab/nait_awg/app/server.js
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/naitlab/nait_awg/data

[Install]
WantedBy=multi-user.target
