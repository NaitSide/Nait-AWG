[Unit]
Description=Nait-AWG Solo Receiver (existing AmneziaWG)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=nait-awg-solo
Group=nait-awg-solo
SupplementaryGroups=docker
WorkingDirectory=/opt/naitlab/nait_awg_solo/receiver
EnvironmentFile=/opt/naitlab/nait_awg_solo/receiver/.env
ExecStart=/opt/naitlab/nait_awg_solo/runtime/bin/node /opt/naitlab/nait_awg_solo/receiver/src/app.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/naitlab/nait_awg_solo/receiver/tmp /opt/naitlab/nait_awg_solo/receiver/backups /opt/naitlab/nait_awg_solo/receiver/locks /opt/naitlab/nait_awg_solo/receiver/state

[Install]
WantedBy=multi-user.target
