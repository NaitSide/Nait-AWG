# Public HTTPS listener. The installer supplies the certificate paths.
HOST=0.0.0.0
PORT=8443
TLS_KEY_PATH=/opt/naitlab/nait_awg/tls/key.pem
TLS_CERT_PATH=/opt/naitlab/nait_awg/tls/cert.pem
# Set false only for an isolated local HTTP check. Production must remain true.
COOKIE_SECURE=true

# Required at runtime. Generate 32 random bytes and encode them as base64.
NAIT_AWG_SESSION_SECRET=
NAIT_AWG_SESSION_TTL_SECONDS=43200
NAIT_AWG_DATA_KEY=
NAIT_AWG_ADMIN_LOGIN=admin
NAIT_AWG_ADMIN_PASSWORD=
NAIT_AWG_AUTH_PATH=./data/admin-auth.json

# Receiver runs only on localhost when Nait-AWG is installed.
RECEIVER_URL=http://127.0.0.1:42842
RECEIVER_API_KEY=
# Dedicated secret for gate writes when Receiver uses trusted-ZTR mode.
AWG_GATE_WRITE_TOKEN=
AWG_CONTAINER_NAME=amnezia-awg
PUBLIC_ENDPOINT_HOST=
# DNS is an application/export preference, not an AWG server parameter.
CLIENT_DNS=1.1.1.1, 1.0.0.1
CLIENT_ALLOWED_IPS=0.0.0.0/0, ::/0
# auto: 25-35 for AWG 3.1; 25 for earlier AWG. Explicit values are preserved.
CLIENT_PERSISTENT_KEEPALIVE=auto
# MTU metadata for new .vpn exports; the native template has no default MTU line.
# desktop: 1376; mobile: 1280. CLIENT_MTU overrides this export policy.
CLIENT_EXPORT_PLATFORM=desktop
CLIENT_MTU=
NAIT_AWG_DATA_PATH=./data/clients.db
